{
  "extends": ["html-validate:recommended"],
  "rules": {
    "no-inline-style": "off",
    "long-title": "off",
    "void-style": ["error", { "style": "omit" }],
    "form-dup-name": ["error", { "shared": ["radio", "checkbox", "button", "reset", "submit"] }],
    "prefer-native-element": ["error", { "exclude": ["progressbar"] }]
  }
}
